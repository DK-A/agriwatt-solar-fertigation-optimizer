{
  "version": 1,
  "author": "Team TECHTONICS",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-s3-devkitc-1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": { "flashSize": "8" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_pressure",
      "top": -90,
      "left": -120,
      "attrs": { "label": "0-100 PSI Pressure Transducer" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_solar",
      "top": -90,
      "left": 140,
      "attrs": { "label": "Solar PV Irradiance (0-1000 W/m2)" }
    },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": -220,
      "left": 0,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-led",
      "id": "led_pump",
      "top": 160,
      "left": -100,
      "attrs": { "color": "blue", "label": "Pump PWM Output" }
    },
    {
      "type": "wokwi-led",
      "id": "led_valve",
      "top": 160,
      "left": 100,
      "attrs": { "color": "green", "label": "Active Zener Solenoid Pulse" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_pulse",
      "top": 100,
      "left": 220,
      "attrs": { "color": "green", "label": "Manual Inject" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:GND.1", "pot_pressure:GND", "black", [ "v0" ] ],
    [ "esp:3V3.1", "pot_pressure:VCC", "red", [ "v0" ] ],
    [ "pot_pressure:SIG", "esp:3", "cyan", [ "v0" ] ],
    [ "esp:GND.2", "pot_solar:GND", "black", [ "v0" ] ],
    [ "esp:3V3.2", "pot_solar:VCC", "red", [ "v0" ] ],
    [ "pot_solar:SIG", "esp:1", "orange", [ "v0" ] ],
    [ "esp:GND.3", "oled:GND", "black", [ "v0" ] ],
    [ "esp:3V3.3", "oled:VCC", "red", [ "v0" ] ],
    [ "esp:8", "oled:SDA", "yellow", [ "v0" ] ],
    [ "esp:9", "oled:SCL", "white", [ "v0" ] ],
    [ "esp:15", "led_pump:A", "blue", [ "v0" ] ],
    [ "esp:GND.4", "led_pump:C", "black", [ "v0" ] ],
    [ "esp:18", "led_valve:A", "green", [ "v0" ] ],
    [ "esp:GND.5", "led_valve:C", "black", [ "v0" ] ],
    [ "btn_pulse:1.l", "esp:0", "green", [ "v0" ] ],
    [ "btn_pulse:2.l", "esp:GND.6", "black", [ "v0" ] ]
  ]
}
